# Smart Waste Management System - Mobile Environment Configuration
# API_BASE_URL notes:
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - Physical Android Device: http://<YOUR_LOCAL_IP>:8000/api/v1 (e.g. http://192.168.1.50:8000/api/v1)
# - iOS Simulator / Web / Desktop: http://127.0.0.1:8000/api/v1
# - Production: https://api.yourdomain.com/api/v1

API_BASE_URL=http://10.0.2.2:8000/api/v1
CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=15000
SEND_TIMEOUT_MS=15000
APP_NAME=Smart Waste Mobile
APP_ENV=development

